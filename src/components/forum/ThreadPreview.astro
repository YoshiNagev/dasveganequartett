---
const { thread } = Astro.props;
---

<a class="thread-preview" href={`/forum/thread/${thread.id}`}>
  <div class="thread-preview-content">
    {
      thread.contextLabel && (
        <span class="thread-context-label">
          {thread.contextLabel}
        </span>
      )
    }

    <h3>{thread.title}</h3>
    <p>{thread.excerpt}</p>
  </div>

  <div class="thread-meta">
    <span>{thread.author}</span>
    <span>
      {thread.replies === 1
        ? "1 Antwort"
        : `${thread.replies} Antworten`}
    </span>
    <span>{thread.createdAt}</span>
  </div>
</a>

<style>
  .thread-preview {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .thread-preview-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .thread-preview-content h3,
  .thread-preview-content p {
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .thread-preview-content h3 {
    margin: 0 0 0.45rem;
  }

  .thread-preview-content p {
    margin: 0;
  }

  .thread-context-label {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 0.65rem;
    padding: 0.42rem 0.7rem;
    border: 1px solid rgba(126, 255, 203, 0.22);
    border-radius: 14px;
    color: var(--accent, #7effcb);
    background: rgba(126, 255, 203, 0.07);
    font-size: 0.75rem;
    font-weight: 850;
    line-height: 1.4;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: auto;
  }

  .thread-meta {
    min-width: 0;
    max-width: 100%;
  }

  .thread-meta span {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .thread-context-label {
      width: 100%;
      border-radius: 10px;
      padding: 0.65rem 0.72rem;
    }

    .thread-preview-content h3 {
      font-size: 1.08rem;
      line-height: 1.25;
    }

    .thread-preview-content p {
      font-size: 0.92rem;
      line-height: 1.55;
    }
  }
</style>
