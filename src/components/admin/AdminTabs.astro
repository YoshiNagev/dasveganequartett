---
interface Props {
  current: "orders" | "reports" | "access" | "withdrawals";
}

const { current } = Astro.props;

const tabs = [
  { id: "withdrawals", href: "/admin/withdrawals", label: "Widerrufe" },
  { id: "orders", href: "/admin/orders", label: "Bestellungen" },
  { id: "reports", href: "/admin/reports", label: "Meldungen" },
  { id: "access", href: "/admin/access", label: "Zugangscodes" },
] as const;
---

<nav class="admin-area-tabs no-print" aria-label="Admin-Bereiche">
  {tabs.map((tab) => (
    <a href={tab.href} aria-current={current === tab.id ? "page" : undefined}>
      {tab.label}
    </a>
  ))}
</nav>

