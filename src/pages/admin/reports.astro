---
import "../../styles/admin-editorial.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportsPanel from "../../components/admin/ReportsPanel.tsx";
import AdminTabs from "../../components/admin/AdminTabs.astro";

export const prerender = false;
---

<BaseLayout design="editorial" title="Moderation · Reports" noindex={true}>
<div class="ea-admin">
  <section class="admin-reports-page">
    <header class="page-header">
      <p class="eyebrow">Administration</p>

      <h1>Meldungen</h1>

      <p>
        Prüfe gemeldete Kommentare und Threads, verbirg problematische Inhalte
        und markiere Meldungen als erledigt.
      </p>
    </header>

    <AdminTabs current="reports" />

    <ReportsPanel client:load />
  </section>
</div>
</BaseLayout>


