---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportsPanel from "../../components/admin/ReportsPanel.tsx";

export const prerender = false;
---

<BaseLayout title="Moderation · Reports">
  <section class="admin-reports-page">
    <header class="page-header">
      <p class="eyebrow">Administration</p>

      <h1>Reports</h1>

      <p>
        Prüfe gemeldete Kommentare und Threads, verbirg problematische Inhalte
        und markiere Meldungen als erledigt.
      </p>
    </header>

    <nav class="admin-tabs" aria-label="Admin-Bereiche">
      <a href="/admin/orders">
        Bestellungen
      </a>

      <a href="/admin/reports" aria-current="page">
        Meldungen
      </a>
    </nav>

    <ReportsPanel client:load />
  </section>
</BaseLayout>

<style>
  .admin-reports-page {
    padding-bottom: 5rem;
  }

  .admin-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .admin-tabs a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;

    padding: 0.7rem 1rem;

    border: 1px solid var(--border);
    border-radius: 999px;

    color: var(--muted-text);
    background: var(--surface);

    font-weight: 900;
    text-decoration: none;

    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }

  .admin-tabs a:hover {
    color: var(--text);
    border-color: rgba(126, 255, 203, 0.35);
    transform: translateY(-1px);
  }

  .admin-tabs a[aria-current="page"] {
    border-color: transparent;
    color: #07110d;
    background: var(--accent);
  }

  .admin-tabs a:focus-visible {
    outline: 3px solid rgba(126, 255, 203, 0.3);
    outline-offset: 3px;
  }

  @media (max-width: 460px) {
    .admin-tabs {
      display: grid;
      grid-template-columns: 1fr;
    }

    .admin-tabs a {
      width: 100%;
    }
  }
</style>