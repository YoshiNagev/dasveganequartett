---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminTabs from "../../components/admin/AdminTabs.astro";
import MarketCodesAdmin from "../../components/admin/MarketCodesAdmin";
---

<BaseLayout title="Zugangscodes verwalten">
  <section class="page-header no-print">
    <p class="eyebrow">Admin · Direktverkauf</p>
    <h1>Zugangskarten erstellen</h1>
    <p>
      Erzeuge einmalige Codes für Weihnachtsmärkte und andere Direktverkäufe.
      Gib pro verkauftem Deck genau eine Zugangskarte aus.
    </p>
  </section>

  <AdminTabs current="access" />
  <MarketCodesAdmin client:load />
</BaseLayout>

<style is:global>
  .market-admin {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 3rem;
  }

  .market-summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .market-summary > div {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
  }

  .market-summary span,
  .code-archive-heading p,
  .code-table small {
    color: var(--muted-text);
  }

  .market-summary strong {
    color: var(--accent);
    font-size: 2rem;
  }

  .market-code-form {
    display: grid;
    grid-template-columns: 140px minmax(240px, 1fr) auto;
    gap: 1rem;
    align-items: end;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }

  .market-code-form label {
    display: grid;
    gap: 0.45rem;
    font-weight: 850;
  }

  .market-code-form input {
    min-width: 0;
    min-height: 46px;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    background: var(--background);
  }

  .market-code-form button,
  .market-toolbar button,
  .code-row-actions button {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.9rem;
    border: 0;
    border-radius: 999px;
    color: #07110d;
    background: var(--accent);
    font: inherit;
    font-weight: 900;
    cursor: pointer;
  }

  .market-code-form button:disabled,
  .market-toolbar button:disabled,
  .code-row-actions button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .market-toolbar {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .market-toolbar button.secondary,
  .code-row-actions button.secondary {
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--surface);
  }

  .access-message {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid rgba(126, 255, 203, 0.25);
    border-radius: 12px;
    color: var(--text);
    background: rgba(126, 255, 203, 0.07);
  }

  .code-archive {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: 20px;
    background: var(--surface);
  }

  .code-archive-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .code-archive-heading h2,
  .code-archive-heading p {
    margin-top: 0;
  }

  .code-table-wrap {
    max-width: 100%;
    overflow-x: auto;
  }

  .code-table {
    width: 100%;
    min-width: 940px;
    border-collapse: collapse;
  }

  .code-table th,
  .code-table td {
    padding: 0.85rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: middle;
  }

  .code-table th {
    color: var(--muted-text);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .code-table td:first-child {
    display: grid;
    gap: 0.3rem;
  }

  .code-table code {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 850;
    white-space: nowrap;
  }

  .code-table small {
    font-size: 0.76rem;
  }

  .code-status {
    display: inline-flex;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 900;
  }

  .code-status.available {
    color: var(--accent);
    border-color: rgba(126, 255, 203, 0.35);
  }

  .code-status.claimed {
    color: #b9dcff;
  }

  .code-status.revoked {
    color: #ffaca8;
  }

  .code-row-actions {
    display: flex;
    gap: 0.5rem;
  }

  .print-only {
    display: none;
  }

  @media (max-width: 760px) {
    .market-summary,
    .market-code-form {
      grid-template-columns: 1fr;
    }

    .code-archive-heading {
      align-items: stretch;
      flex-direction: column;
    }
  }

  @media print {
    @page {
      size: A4 portrait;
      margin: 8mm;
    }

    html,
    body,
    main,
    .site-main {
      width: auto !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
      color: #000 !important;
      background: #fff !important;
    }

    .site-header,
    .site-footer-custom,
    .page-header,
    .admin-area-tabs,
    .market-admin > :not(.print-only) {
      display: none !important;
    }

    .market-admin {
      display: block !important;
      padding: 0 !important;
    }

    .print-only.print-code-grid {
      display: grid !important;
      grid-template-columns: repeat(3, 60mm);
      align-items: start;
      justify-content: start;
      gap: 4mm;
      margin: 0 !important;
      padding: 0 !important;
    }

    .print-code-card {
      box-sizing: border-box;
      break-inside: avoid;
      display: grid;
      width: 60mm;
      min-height: 69mm;
      align-content: start;
      justify-items: center;
      gap: 2.5mm;
      padding: 4mm;
      border: 0.3mm dashed #777;
      border-radius: 0;
      color: #000;
      background: #fff;
      text-align: center;
    }

    .print-code-card p,
    .print-code-card strong,
    .print-code-card small {
      margin: 0;
      color: #000;
    }

    .print-code-card p {
      font-size: 9pt;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .print-code-card img {
      display: block;
      width: 42mm;
      height: 42mm;
    }

    .print-code-card strong {
      font-family: Arial, sans-serif;
      font-size: 10pt;
      letter-spacing: 0.06em;
    }

    .print-code-card small {
      font-size: 7.5pt;
    }
  }
</style>
