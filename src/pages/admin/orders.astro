---
import "../../styles/admin-editorial.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrdersAdmin from "../../components/admin/OrdersAdmin";
import AdminTabs from "../../components/admin/AdminTabs.astro";

export const prerender = false;
---

<BaseLayout design="editorial" title="Bestellungen verwalten" noindex={true}>
<div class="ea-admin">
  <section class="admin-orders-page">
    <header class="page-header">
      <p class="eyebrow">Administration</p>

      <h1>Bestellungen</h1>

      <p>
        Bezahlte Bestellungen prüfen, Lieferadressen einsehen und
        Versandstatus verwalten.
      </p>
    </header>

    <AdminTabs current="orders" />

    <OrdersAdmin client:load />
  </section>
</div>
</BaseLayout>


