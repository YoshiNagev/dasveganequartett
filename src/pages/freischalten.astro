---
import BaseLayout from "../layouts/BaseLayout.astro";
import RedeemAccess from "../components/access/RedeemAccess";
import "../styles/auth-editorial.css";
import "../styles/redeem-editorial.css";
const initialCode = Astro.url.searchParams.get("code") ?? "";
---
<BaseLayout design="editorial" title="Digitalen Zugang freischalten" noindex={true}>
  <section class="ea-page ed-redeem" aria-labelledby="redeem-title">
    <div class="ea-copy">
      <p class="ed-kicker">Dein Quartett · Digitaler Zugang</p>
      <h1 id="redeem-title">Mehr Karten.<br />Mehr Gespräch.</h1>
      <p class="ea-lead">Mit deinem Zugangscode öffnest du alle 54 Argumente und die vollständigen Diskussionen. Löse hier den Code von deiner Zugangskarte oder deinem Geschenklink ein.</p>
      <aside class="ea-note"><h2>Ein Code. Dein Zugang.</h2><p>Der Code lässt sich einmal einlösen und wird dabei deinem angemeldeten Profil zugeordnet. Prüfe deshalb vor dem Freischalten, ob du das richtige Konto verwendest.</p></aside>
      <a class="ea-explore" href="/cards">Erst einmal die Karten entdecken <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ea-panel">
      <RedeemAccess client:load initialCode={initialCode} />
      <noscript><p class="ea-noscript">Bitte aktiviere JavaScript, um deinen Zugangscode einzulösen.</p></noscript>
      <details class="ed-redeem-help"><summary>Fragen zum Freischalten</summary><h3>Du hast einen Geschenklink?</h3><p>Der Code wird aus dem Link übernommen. Nach dem Einloggen kannst du ihn hier selbst bestätigen.</p><h3>Der Code funktioniert nicht?</h3><p>Prüfe, ob du den vollständigen Code eingegeben hast. Bereits eingelöste Codes können nicht erneut verwendet werden. Unter „Meine Zugänge“ siehst du deinen aktuellen Zugang.</p><a href="/account/access">Meine Zugänge öffnen</a></details>
    </div>
  </section>
</BaseLayout>
