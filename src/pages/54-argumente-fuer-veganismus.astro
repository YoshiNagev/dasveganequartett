---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "54 Argumente für Veganismus";
const pageDescription =
  "Eine kostenlose PDF mit 54 ausführlich erklärten Argumenten für Veganismus und Tierrechte als Ergänzung zum Veganen Quartett.";

const pdfUrl = "/downloads/54-argumente-fuer-veganismus.pdf";
const coverUrl = "/images/54-argumente-fuer-veganismus-cover.png";

const categories = [
  {
    number: "01",
    title: "Philosophische Argumente",
    description:
      "Unparteilichkeit, Speziesismus, moralische Rechte und verschiedene ethische Ansätze führen zu der Frage, ob wir Tiere allein aufgrund ihrer Artzugehörigkeit als Ressourcen behandeln dürfen.",
  },
  {
    number: "02",
    title: "Während die Tiere leben",
    description:
      "Fortpflanzung, Familienbindungen, Zucht, Haltung, körperliche Eingriffe und Transporte zeigen, wie umfassend die Interessen der Tiere menschlichen Produktionszielen untergeordnet werden.",
  },
  {
    number: "03",
    title: "Wie Tiere sterben",
    description:
      "Dieses Kapitel untersucht Betäubungs- und Tötungsverfahren, wie es den Tieren dabei geht und hinterfragt dabei, warum Tiere aktuell überhaupt so getötet werden.",
  },
  {
    number: "04",
    title: "Gesellschaftliche Argumente",
    description:
      "Tierausbeutung ist nicht nur eine private Konsumentscheidung, sondern Teil wirtschaftlicher, politischer und kultureller Strukturen, die Arbeitsbedingungen, Verantwortung und gesellschaftlichen Wandel prägen.",
  },
  {
    number: "05",
    title: "Gesundheit, Umwelt & Nachhaltigkeit",
    description:
      "Die Nutzung von Tieren beeinflusst Ernährung, Ressourcenverbrauch, Klima, Landnutzung und globale Versorgung. Diese Folgen sind zusätzliche Gründe für Veränderung, nicht die Grundlage des moralischen Werts der Tiere.",
  },
  {
    number: "06",
    title: "Weitere Formen der Tierausbeutung",
    description:
      "Auch außerhalb der Ernährung werden Tiere für Kleidung, Forschung, Unterhaltung, Sport und Luxusprodukte genutzt. Das Kapitel macht sichtbar, wie weit das Prinzip tierlicher Verfügbarkeit reicht.",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="pdf-page">
    <section class="hero" aria-labelledby="page-title">
      <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
      <div class="hero__glow hero__glow--two" aria-hidden="true"></div>

      <div class="page-shell hero__grid">
        <div class="hero__content">
          <a class="back-link" href="/cards">
            <span aria-hidden="true">←</span>
            Zu den 54 Gegenargumenten
          </a>

          <p class="eyebrow">Kostenlose Ergänzung zum Veganen Quartett</p>

          <h1 id="page-title">
            54 Argumente
            <span>für Veganismus</span>
          </h1>

          <p class="hero__description">
            Warum sollten wir ohne die Ausbeutung nichtmenschlicher Tiere
            leben? Diese PDF versammelt 54 ausführlich erklärte Argumente
            für Veganismus und Tierrechte.
          </p>

          <div class="hero__actions" aria-label="PDF-Aktionen">
            <a
              class="button button--primary"
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
              >
                <path
                  d="M4 3.75A1.75 1.75 0 0 1 5.75 2h8.5L20 7.75v12.5A1.75 1.75 0 0 1 18.25 22H5.75A1.75 1.75 0 0 1 4 20.25V3.75Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                />
                <path
                  d="M14 2.5V8h5.5M8 13h8M8 17h5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              PDF lesen
            </a>

            <a
              class="button button--secondary"
              href={pdfUrl}
              download="54-Argumente-fuer-Veganismus.pdf"
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
              >
                <path
                  d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>

              Herunterladen
            </a>

            <button
              id="share-page"
              class="button button--secondary"
              type="button"
              data-title={pageTitle}
              data-text="Lies kostenlos 54 Argumente für Veganismus und Tierrechte."
            >
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                width="20"
                height="20"
              >
                <circle
                  cx="18"
                  cy="5"
                  r="2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <circle
                  cx="6"
                  cy="12"
                  r="2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <circle
                  cx="18"
                  cy="19"
                  r="2.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
                <path
                  d="m8.2 10.8 7.6-4.6M8.2 13.2l7.6 4.6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
              </svg>

              <span id="share-label">Seite teilen</span>
            </button>
          </div>

          <p id="share-status" class="share-status" aria-live="polite"></p>

          <ul class="hero__facts" aria-label="Informationen über die PDF">
            <li>
              <strong>54</strong>
              <span>Argumente</span>
            </li>
            <li>
              <strong>6</strong>
              <span>Kategorien</span>
            </li>
            <li>
              <strong>0 €</strong>
              <span>Kostenlos</span>
            </li>
          </ul>
        </div>

        <div class="cover-column">
          <div class="cover-card">
            <div class="cover-card__shadow" aria-hidden="true"></div>

            <img
              src={coverUrl}
              alt="Cover der PDF 54 Argumente für Veganismus"
              width="1200"
              height="1697"
              loading="eager"
            />
          </div>

          <p class="cover-note">
            Kostenlos lesen, herunterladen und weitergeben
          </p>
        </div>
      </div>
    </section>

    <section class="introduction">
      <div class="page-shell">
        <div class="introduction__card">
          <div class="introduction__heading">
            <p class="section-label">Worum geht es?</p>

            <h2>
              Die positive Ergänzung zu den
              <span>54 Gegenargumenten</span>
            </h2>
          </div>

          <div class="introduction__text">
            <p>
              Ein einziges überzeugendes Argument könnte genügen: Empfindungsfähige
              Tiere sollten nicht für menschliche Zwecke ausgebeutet und
              getötet werden. Trotzdem nähern sich Menschen dieser Einsicht auf sehr
              unterschiedlichen Wegen. Manche beginnen bei philosophischen Fragen,
              andere bei Tierhaltung, Schlachtung, Gesundheit, Umwelt oder verborgenen
              Formen der Tierausbeutung.
            </p>

            <p>
              Die 54 Argumente sind deshalb keine Sammlung gleichwertiger Beweise,
              sondern sechs Perspektiven auf dieselbe grundlegende Frage: Warum glauben
              wir, über die Körper und das Leben anderer Tiere verfügen zu dürfen?
              Zusätzliche Vorteile für Menschen und Umwelt werden dabei berücksichtigt,
              ohne die Tiere aus dem Mittelpunkt zu verdrängen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="categories" aria-labelledby="categories-title">
      <div class="page-shell">
        <div class="section-heading">
          <div>
            <p class="section-label">Inhalt</p>
            <h2 id="categories-title">Sechs Themenbereiche</h2>
          </div>

          <p>
            Die 54 Argumente sind in sechs übersichtliche Kategorien mit
            jeweils neun Argumenten gegliedert.
          </p>
        </div>

        <div class="category-grid">
          {
            categories.map((category) => (
              <article class="category-card">
                <span class="category-card__number">
                  {category.number}
                </span>

                <h3>{category.title}</h3>
                <p>{category.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="reader-section" aria-labelledby="reader-title">
      <div class="page-shell">
        <div class="reader-heading">
          <div>
            <p class="section-label">Direkt lesen</p>
            <h2 id="reader-title">PDF-Vorschau</h2>
          </div>

          <a
            class="text-link"
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            In neuem Tab öffnen
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="pdf-reader">
          <iframe
            src={`${pdfUrl}#view=FitH`}
            title="Vorschau der PDF 54 Argumente für Veganismus"
            loading="lazy"
          ></iframe>

          <div class="pdf-reader__fallback">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="32"
              height="32"
            >
              <path
                d="M4 3.75A1.75 1.75 0 0 1 5.75 2h8.5L20 7.75v12.5A1.75 1.75 0 0 1 18.25 22H5.75A1.75 1.75 0 0 1 4 20.25V3.75Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
              <path
                d="M14 2.5V8h5.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linejoin="round"
              />
            </svg>

            <p>
              Dein Browser unterstützt möglicherweise keine eingebettete
              PDF-Vorschau.
            </p>

            <a
              class="button button--primary"
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              PDF öffnen
            </a>
          </div>
        </div>

        <p class="reader-hint">
          Auf manchen Smartphones wird die PDF nicht eingebettet angezeigt.
          Verwende dort einfach „PDF lesen“ oder „Herunterladen“.
        </p>
      </div>
    </section>

    <section class="final-cta">
      <div class="page-shell">
        <div class="final-cta__card">
          <div>
            <p class="section-label">Kostenlos verfügbar</p>

            <h2>54 Gründe, unsere Beziehung zu Tieren neu zu betrachten</h2>

            <p>
              Lies die PDF direkt im Browser, speichere sie auf deinem Gerät
              oder teile diese Seite mit anderen.
            </p>
          </div>

          <div class="final-cta__actions">
            <a
              class="button button--light"
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Jetzt lesen
            </a>

            <a class="button button--outline-light" href="/cards">
              Gegenargumente ansehen
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    const shareButton = document.querySelector<HTMLButtonElement>("#share-page");
    const shareLabel = document.querySelector<HTMLElement>("#share-label");
    const shareStatus = document.querySelector<HTMLElement>("#share-status");

    function showShareMessage(message: string) {
      if (!shareStatus || !shareLabel) return;

      shareStatus.textContent = message;
      shareLabel.textContent = message === "Link kopiert." ? "Link kopiert" : "Seite teilen";

      window.setTimeout(() => {
        shareStatus.textContent = "";
        shareLabel.textContent = "Seite teilen";
      }, 3000);
    }

    shareButton?.addEventListener("click", async () => {
      const title = shareButton.dataset.title ?? document.title;
      const text =
        shareButton.dataset.text ??
        "54 Argumente für Veganismus und Tierrechte.";
      const url = window.location.href;

      if (navigator.share) {
        try {
          await navigator.share({
            title,
            text,
            url,
          });

          showShareMessage("Seite geteilt.");
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          console.error("Teilen fehlgeschlagen:", error);
          showShareMessage("Teilen war nicht möglich.");
        }

        return;
      }

      try {
        await navigator.clipboard.writeText(url);
        showShareMessage("Link kopiert.");
      } catch (error) {
        console.error("Kopieren fehlgeschlagen:", error);

        window.prompt("Kopiere diesen Link:", url);
      }
    });
  </script>
</BaseLayout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  .pdf-page {
    --page-bg: #f4f6f1;
    --surface: #ffffff;
    --surface-soft: #edf2e9;
    --text: #172018;
    --text-soft: #5e6b60;
    --accent: #497f42;
    --accent-strong: #315f2d;
    --accent-light: #dcebd7;
    --line: rgba(23, 32, 24, 0.12);
    --shadow: 0 24px 70px rgba(29, 48, 31, 0.13);

    color: var(--text);
    background: var(--page-bg);
    overflow: hidden;
  }

  .page-shell {
    width: min(1120px, calc(100% - clamp(56px, 7vw, 112px)));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    padding: clamp(78px, 8vw, 118px) 0 clamp(82px, 8vw, 120px);
    background:
      linear-gradient(135deg, rgba(220, 235, 215, 0.58), transparent 48%),
      var(--page-bg);
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    border-radius: 999px;
    filter: blur(8px);
    pointer-events: none;
  }

  .hero__glow--one {
    width: 430px;
    height: 430px;
    top: -180px;
    right: -100px;
    background: rgba(119, 174, 103, 0.16);
  }

  .hero__glow--two {
    width: 300px;
    height: 300px;
    bottom: -100px;
    left: -120px;
    background: rgba(166, 197, 149, 0.18);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(300px, 0.66fr);
    gap: clamp(52px, 7vw, 86px);
    align-items: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 42px;
    color: var(--text-soft);
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .back-link:hover {
    color: var(--accent-strong);
    transform: translateX(-3px);
  }

  .eyebrow,
  .section-label {
    margin: 0 0 15px;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(3.15rem, 5.7vw, 5.55rem);
    line-height: 0.96;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero h1 span {
    display: block;
    color: var(--accent);
  }

  .hero__description {
    max-width: 700px;
    margin: 32px 0 0;
    color: var(--text-soft);
    font-size: clamp(1.08rem, 1.8vw, 1.3rem);
    line-height: 1.72;
  }

  .hero__actions,
  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__actions {
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 19px;
    border: 1px solid transparent;
    border-radius: 13px;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 750;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button:focus-visible,
  .back-link:focus-visible,
  .text-link:focus-visible {
    outline: 3px solid rgba(73, 127, 66, 0.34);
    outline-offset: 3px;
  }

  .button--primary {
    color: #ffffff;
    background: var(--accent-strong);
    box-shadow: 0 12px 28px rgba(49, 95, 45, 0.2);
  }

  .button--primary:hover {
    background: #274e24;
    box-shadow: 0 15px 35px rgba(49, 95, 45, 0.27);
  }

  .button--secondary {
    color: var(--text);
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.72);
  }

  .button--secondary:hover {
    border-color: rgba(49, 95, 45, 0.32);
    background: #ffffff;
  }

  .share-status {
    min-height: 22px;
    margin: 12px 0 0;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 17px 34px;
    margin: 35px 0 0;
    padding: 27px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .hero__facts li {
    display: grid;
    gap: 2px;
  }

  .hero__facts strong {
    font-size: 1.22rem;
  }

  .hero__facts span {
    color: var(--text-soft);
    font-size: 0.83rem;
  }

  .cover-column {
    display: grid;
    justify-items: center;
  }

  .cover-card {
    position: relative;
    width: min(100%, 350px);
    transform: rotate(1.6deg);
    transition: transform 240ms ease;
  }

  .cover-card:hover {
    transform: rotate(0deg) translateY(-6px);
  }

  .cover-card__shadow {
    position: absolute;
    inset: 7% -5% -5% 8%;
    z-index: -1;
    border-radius: 22px;
    background: rgba(35, 62, 37, 0.23);
    filter: blur(26px);
  }

  .cover-card img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(23, 32, 24, 0.1);
    border-radius: 6px;
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .cover-note {
    margin: 26px 0 0;
    color: var(--text-soft);
    font-size: 0.84rem;
    text-align: center;
  }

  .introduction,
  .categories,
  .reader-section,
  .final-cta {
    padding: clamp(76px, 9vw, 125px) 0;
  }

  .introduction {
    position: relative;
    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(119, 174, 103, 0.12),
        transparent 34%
      ),
      var(--surface);
  }

  .introduction__card {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 72px);
    border: 1px solid rgba(23, 32, 24, 0.09);
    border-radius: 30px;
    background:
      linear-gradient(
        135deg,
        rgba(237, 242, 233, 0.95),
        rgba(255, 255, 255, 0.96)
      );
    box-shadow: 0 24px 60px rgba(29, 48, 31, 0.1);
  }

  .introduction__card::before {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    top: -150px;
    right: -90px;
    border-radius: 999px;
    background: rgba(73, 127, 66, 0.12);
    pointer-events: none;
  }

  .introduction__heading {
    position: relative;
    max-width: 880px;
    padding-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--line);
  }

  .introduction h2,
  .section-heading h2,
  .reader-heading h2,
  .final-cta h2 {
    margin: 0;
    font-size: clamp(2.15rem, 4.3vw, 4.1rem);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }

  .introduction h2 {
    max-width: 820px;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .introduction h2 span {
    color: var(--accent);
  }

  .introduction__text {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 64px);
    margin-top: clamp(28px, 4vw, 46px);
    color: var(--text-soft);
    font-size: clamp(1rem, 1.2vw, 1.1rem);
    font-weight: 450;
    line-height: 1.82;
  }

  .introduction__text p {
    margin: 0;
  }

  .introduction__text p + p {
    margin-top: 0;
  }

  .categories {
    background: var(--surface-soft);
  }

  .section-heading,
  .reader-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 45px;
  }

  .section-heading > p {
    max-width: 480px;
    margin: 0;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .category-card {
    min-height: 270px;
    padding: 28px;
    border: 1px solid rgba(23, 32, 24, 0.09);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.78);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .category-card:hover {
    transform: translateY(-5px);
    border-color: rgba(73, 127, 66, 0.2);
    box-shadow: 0 18px 45px rgba(35, 62, 37, 0.09);
  }

  .category-card__number {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    margin-bottom: 42px;
    border-radius: 999px;
    color: var(--accent-strong);
    background: var(--accent-light);
    font-size: 0.77rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .category-card h3 {
    margin: 0;
    font-size: 1.24rem;
    line-height: 1.25;
  }

  .category-card p {
    margin: 14px 0 0;
    color: var(--text-soft);
    font-size: 0.94rem;
    line-height: 1.68;
  }

  .reader-section {
    background: var(--surface);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-strong);
    font-weight: 750;
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .pdf-reader {
    position: relative;
    min-height: 720px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: #dedede;
    box-shadow: 0 25px 65px rgba(29, 48, 31, 0.12);
  }

  .pdf-reader iframe {
    display: block;
    width: 100%;
    height: min(84vh, 980px);
    min-height: 720px;
    border: 0;
    background: #ffffff;
  }

  .pdf-reader__fallback {
    display: none;
    min-height: 460px;
    place-items: center;
    align-content: center;
    gap: 15px;
    padding: 35px;
    color: var(--text-soft);
    text-align: center;
  }

  .pdf-reader__fallback p {
    max-width: 420px;
    margin: 0 0 8px;
    line-height: 1.6;
  }

  .reader-hint {
    margin: 18px 0 0;
    color: var(--text-soft);
    font-size: 0.85rem;
    text-align: center;
  }

  .final-cta {
    background: var(--page-bg);
  }

  .final-cta__card {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) auto;
    gap: 55px;
    align-items: center;
    padding: clamp(36px, 6vw, 70px);
    border-radius: 30px;
    color: #ffffff;
    background:
      radial-gradient(
        circle at 100% 0%,
        rgba(179, 219, 166, 0.2),
        transparent 35%
      ),
      #274d29;
    box-shadow: 0 30px 70px rgba(29, 56, 31, 0.19);
  }

  .final-cta .section-label {
    color: #bce2b3;
  }

  .final-cta h2 {
    max-width: 760px;
    font-size: clamp(2rem, 4vw, 3.65rem);
  }

  .final-cta p:not(.section-label) {
    max-width: 660px;
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.74);
    line-height: 1.75;
  }

  .final-cta__actions {
    justify-content: flex-end;
  }

  .button--light {
    color: #244626;
    background: #ffffff;
  }

  .button--light:hover {
    background: #f1f7ef;
  }

  .button--outline-light {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: transparent;
  }

  .button--outline-light:hover {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__content {
      text-align: center;
    }

    .back-link {
      margin-inline: auto;
    }

    .hero__description {
      margin-inline: auto;
    }

    .hero__actions,
    .hero__facts {
      justify-content: center;
    }

    .cover-card {
      width: min(78vw, 365px);
    }

    .introduction__text {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .final-cta__card {
      grid-template-columns: 1fr;
    }

    .final-cta__actions {
      justify-content: flex-start;
    }
  }

  @media (max-width: 680px) {
    .page-shell {
      width: min(100% - 36px, 1120px);
    }

    .hero {
      padding-top: 60px;
    }

    .back-link {
      margin-bottom: 32px;
    }

    .hero h1 {
      font-size: clamp(2.85rem, 14vw, 4.15rem);
    }

    .introduction__card {
      padding: 28px 22px;
      border-radius: 22px;
    }

    .introduction h2 {
      font-size: clamp(2.15rem, 10vw, 3.35rem);
      line-height: 1.02;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .introduction h2 span {
      display: block;
      max-width: 100%;
      font-size: inherit;
      letter-spacing: inherit;
      white-space: normal;
    }

    .introduction__text {
      font-size: 1rem;
      line-height: 1.72;
    }

    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .button {
      width: 100%;
    }

    .hero__facts {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .hero__facts li {
      justify-items: center;
    }

    .section-heading,
    .reader-heading {
      display: grid;
      align-items: start;
      gap: 20px;
    }

    .category-grid {
      grid-template-columns: 1fr;
    }

    .category-card {
      min-height: 0;
    }

    .category-card__number {
      margin-bottom: 30px;
    }

    .pdf-reader {
      min-height: 600px;
      border-radius: 16px;
    }

    .pdf-reader iframe {
      height: 76vh;
      min-height: 600px;
    }

    .final-cta__card {
      gap: 34px;
      border-radius: 22px;
    }

    .final-cta__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 430px) {
    .page-shell {
      width: min(100% - 16px, 1120px);
    }

    .introduction__card {
      padding-inline: 14px;
    }

    .introduction h2 {
      font-size: clamp(1.9rem, 8.8vw, 2.35rem);
      line-height: 1.02;
      letter-spacing: -0.05em;
      text-wrap: balance;
    }

    .introduction h2 span {
      font-size: inherit;
      letter-spacing: inherit;
      white-space: normal;
    }
  }

  @media (max-width: 360px) {
    .introduction h2 {
      font-size: clamp(1.78rem, 8.4vw, 2rem);
    }
  }

  /*
   * Auf kleinen iPhones und iPads ist das Einbetten von PDFs teilweise
   * unzuverlässig. Die Vorschau wird dort ausgeblendet und durch einen
   * klaren Öffnen-Button ersetzt.
   */
  @supports (-webkit-touch-callout: none) {
    @media (max-width: 820px) {
      .pdf-reader {
        min-height: 460px;
        background: var(--surface-soft);
      }

      .pdf-reader iframe {
        display: none;
      }

      .pdf-reader__fallback {
        display: grid;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(*) {
      scroll-behavior: auto !important;
    }

    .button,
    .back-link,
    .cover-card,
    .category-card {
      transition: none;
    }
  }
</BaseLayout>