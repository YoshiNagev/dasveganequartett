---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ForgotPasswordForm from "../../components/account/ForgotPasswordForm";
---

<BaseLayout title="Passwort vergessen">
  <section class="auth-page">
    <div class="auth-copy">
      <p class="eyebrow">Account wiederherstellen</p>
      <h1>Neues Passwort anfordern.</h1>
      <p>
        Gib die E-Mail-Adresse deines Profils ein. Wir schicken dir einen
        sicheren Link, über den du ein neues Passwort festlegen kannst.
      </p>
    </div>

    <ForgotPasswordForm client:load />
  </section>
</BaseLayout>
