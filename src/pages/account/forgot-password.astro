---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ForgotPasswordForm from "../../components/account/ForgotPasswordForm";
import "../../styles/auth-editorial.css";
import "../../styles/account-recovery-editorial.css";
---
<BaseLayout design="editorial" title="Passwort vergessen" noindex={true}>
  <section class="ea-page er-page" aria-labelledby="auth-title">
    <div class="ea-copy"><p class="ed-kicker">Dein Konto · Passwort</p><h1 id="auth-title">Passwort<br />vergessen?</h1><p class="ea-lead">Gib die E-Mail-Adresse deines Kontos ein, um einen Link zum Zurücksetzen anzufordern.</p>
      <aside class="ea-note"><h2>Gut zu wissen</h2><p>Der Link führt dich zurück auf diese Website. Prüfe auch deinen Spam-Ordner, falls du die E-Mail nicht findest.</p></aside>
      <a class="ea-explore" href="/account/login">Zurück zum Einloggen <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ea-panel"><ForgotPasswordForm client:load /><noscript><p class="ea-noscript">Bitte aktiviere JavaScript, um dein Passwort zurückzusetzen.</p></noscript></div>
  </section>
</BaseLayout>
