---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResetPasswordForm from "../../components/account/ResetPasswordForm";
import "../../styles/auth-editorial.css";
import "../../styles/account-recovery-editorial.css";
---
<BaseLayout design="editorial" title="Neues Passwort festlegen" noindex={true}>
  <section class="ea-page er-page" aria-labelledby="auth-title">
    <div class="ea-copy"><p class="ed-kicker">Dein Konto · Passwort</p><h1 id="auth-title">Ein neuer<br />Anfang.</h1><p class="ea-lead">Lege ein neues Passwort für dein Konto fest. Es muss mindestens acht Zeichen lang sein.</p>
      <aside class="ea-note"><h2>Gut gewählt.</h2><p>Verwende ein Passwort, das du für kein anderes Konto nutzt. Ein Passwortmanager kann dir beim Erstellen und Speichern helfen.</p></aside>
      <a class="ea-explore" href="/account/login">Zurück zum Einloggen <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ea-panel"><ResetPasswordForm client:load /><noscript><p class="ea-noscript">Bitte aktiviere JavaScript, um dein Passwort zurückzusetzen.</p></noscript></div>
  </section>
</BaseLayout>
