---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResetPasswordForm from "../../components/account/ResetPasswordForm";
---

<BaseLayout title="Neues Passwort festlegen">
  <section class="auth-page">
    <div class="auth-copy">
      <p class="eyebrow">Account wiederherstellen</p>
      <h1>Lege ein neues Passwort fest.</h1>
      <p>
        Dein neues Passwort muss mindestens acht Zeichen lang sein. Nach dem
        Speichern kannst du dein Profil wieder wie gewohnt verwenden.
      </p>
    </div>

    <ResetPasswordForm client:load />
  </section>
</BaseLayout>
