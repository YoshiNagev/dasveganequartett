---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterForm from "../../components/account/RegisterForm";
import { safeReturnPath } from "../../lib/access";
import "../../styles/auth-editorial.css";

const returnTo = safeReturnPath(Astro.url.searchParams.get("returnTo"));
---
<BaseLayout design="editorial" title="Registrieren" noindex={true}>
  <section class="ea-page" aria-labelledby="auth-title">
    <div class="ea-copy"><p class="ed-kicker">Das Vegane Quartett · Dein Konto</p><h1 id="auth-title">Dein Platz<br />am Spieltisch.</h1><p class="ea-lead">Erstelle dein Konto, diskutiere mit und verwalte deine digitalen Zugänge an einem Ort.</p>
      {returnTo === "/preorder" && <p class="ea-return">Nach dem Einloggen geht es zurück zu deiner Vorbestellung.</p>}
      <aside class="ea-note"><h2>Ein Konto. Viele Gespräche.</h2><p>Die Registrierung ist kostenlos. Sechs Argumentseiten sind auch ohne Zugang frei lesbar. Für alle 54 Argumentseiten brauchst du zusätzlich einen freigeschalteten Zugang.</p></aside>
      <a class="ea-explore" href="/cards">Erst einmal die Karten entdecken <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ea-panel"><RegisterForm client:load returnTo={returnTo} /><noscript><p class="ea-noscript">Bitte aktiviere JavaScript, um dich einzuloggen oder ein Konto zu erstellen.</p></noscript></div>
  </section>
</BaseLayout>
