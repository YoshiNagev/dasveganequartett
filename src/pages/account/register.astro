---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RegisterForm from "../../components/account/RegisterForm";
import { safeReturnPath } from "../../lib/access";

const returnTo = safeReturnPath(Astro.url.searchParams.get("returnTo"));
---

<BaseLayout title="Registrieren">
  <section class="auth-page">
    <div class="auth-copy">
      <p class="eyebrow">Account</p>
      <h1>Werde Teil der Diskussion.</h1>
      <p>
        Im Forum wird nur dein Nickname angezeigt. Deine E-Mail bleibt privat.
      </p>
    </div>

    <RegisterForm client:load returnTo={returnTo} />
  </section>
</BaseLayout>
