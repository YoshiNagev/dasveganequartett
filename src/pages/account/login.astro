---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginForm from "../../components/account/LoginForm";
import { safeReturnPath } from "../../lib/access";

const returnTo = safeReturnPath(Astro.url.searchParams.get("returnTo"));
---

<BaseLayout title="Einloggen">
  <section class="auth-page">
    <div class="auth-copy">
      <p class="eyebrow">Login</p>
      <h1>Willkommen zurück.</h1>
      <p>
        Logge dich ein, um deine Käufe, digitalen Zugänge und Diskussionen zu
        verwalten.
      </p>
    </div>

    <LoginForm client:load returnTo={returnTo} />
  </section>
</BaseLayout>
