---
import "../../styles/forum-editorial.css";
import ForumNav from "../../components/forum/ForumNav.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cards } from "../../data/cards";
import AccessGate from "../../components/access/AccessGate.astro";
import { PUBLIC_CARD_IDS } from "../../lib/access";
import { getAccessState } from "../../lib/server/access";
import { createSupabaseServerClient } from "../../lib/supabaseServer";

export const prerender = false;

const access = await getAccessState(Astro.cookies, Astro.request);
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const visibleCards = access.hasFullAccess
  ? cards
  : cards.filter((card) =>
      PUBLIC_CARD_IDS.includes(card.id as (typeof PUBLIC_CARD_IDS)[number])
    );

const { data: threads, error } = await supabase
  .from("threads")
  .select("card_id")
  .eq("is_hidden", false);

if (error) {
  console.error(error);
}

const cardsWithThreads = visibleCards.map((card) => ({
  ...card,
  threadCount:
    threads?.filter((thread) => thread.card_id === card.id).length ?? 0,
}));
---

<BaseLayout design="editorial" title="Forum">
  <div class="ef-forum">
  <ForumNav currentPath={Astro.url.pathname} />
  <section class="page-header">
    <p class="eyebrow">Forum</p>

    <h1>{access.hasFullAccess ? "Hier geht das Gespräch weiter." : "Sechs Karten. Viele Perspektiven."}</h1>

    <p>
      {access.hasFullAccess
        ? "Finde schnell das Argument, über das du diskutieren möchtest."
        : "Zu den sechs Beispielkarten kannst du bereits öffentlich mitdiskutieren. Der vollständige Bereich wird mit einem Deck freigeschaltet."}
    </p>
  </section>

  <aside class="ef-guidance"><p>Stell Fragen, teile Erfahrungen und belege sachliche Aussagen nach Möglichkeit mit Quellen. Bleib beim Argument und respektvoll gegenüber anderen.</p></aside>
  {error && <p class="ef-error" role="alert">Die Anzahl der Diskussionen konnte gerade nicht geladen werden. Die Kartenforen kannst du weiterhin öffnen.</p>}
  <section class="forum-card-grid">
    {cardsWithThreads.map((card) => (
      <a href={`/forum/card/${card.id}`} class="forum-card-link" data-category={Math.floor((card.id - 1) / 9)}>
        <span>#{String(card.id).padStart(2, "0")}</span>

        <h2>{card.title}</h2>

        <p>{card.categoryLabel}</p>

        <strong>
          {error ? "Diskussionen öffnen" : card.threadCount === 1
            ? "1 Diskussion"
            : `${card.threadCount} Diskussionen`}
        </strong>
      </a>
    ))}
  </section>

  {access.hasFullAccess && <div class="forum-action-grid">
    <a
      class="create-thread-link full-width"
      href="/forum/threads"
    >
      Alle Threads ansehen
    </a>

    <a
      class="create-thread-link full-width"
      href="/forum/suggest"
    >
      Zusätzliche Argumente ansehen
    </a>
  </div>}

  {!access.hasFullAccess && (
    <AccessGate
      returnTo="/forum"
      headingLevel="h2"
      eyebrow="Käuferforum"
      title="48 weitere Argumentforen warten auf dich."
      message="Aktiviere den digitalen Zugang eines Decks, um sämtliche Diskussionen und Community-Vorschläge zu öffnen."
    />
  )}
  </div>
</BaseLayout>
