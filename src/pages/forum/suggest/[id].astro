---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ThreadPreview from "../../../components/forum/ThreadPreview.astro";
import CreateSuggestedThreadForm from "../../../components/forum/CreateSuggestedThreadForm";
import AccessGate from "../../../components/access/AccessGate.astro";
import { getAccessState } from "../../../lib/server/access";
import { createSupabaseServerClient } from "../../../lib/supabaseServer";

export const prerender = false;

const { id } = Astro.params;
const access = await getAccessState(Astro.cookies, Astro.request);
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);

const { data: argument, error } = access.hasFullAccess ? await supabase
  .from("suggested_arguments")
  .select(`
    id,
    title,
    description,
    status,
    created_at,
    profiles (
      nickname
    ),
    threads (
      id,
      title,
      body,
      slug,
      created_at,
      comments (
        id
      ),
      profiles (
        nickname
      )
    )
  `)
  .eq("id", id)
  .eq("is_hidden", false)
  .maybeSingle() : { data: null, error: null };

if (access.hasFullAccess && (error || !argument)) {
  return Astro.redirect("/forum/suggest");
}

const displayThreads =
  argument?.threads?.map((thread) => ({
    id: thread.slug,
    cardId: null,
    title: thread.title,
    excerpt: thread.body,
    author: (Array.isArray(thread.profiles) ? thread.profiles[0] : thread.profiles)?.nickname ?? "Unbekannt",
    replies: thread.comments?.length ?? 0,
    createdAt: new Date(thread.created_at).toLocaleDateString("de-DE"),
  })) ?? [];
const argumentProfile = Array.isArray(argument?.profiles)
  ? argument?.profiles[0]
  : argument?.profiles;
---

<BaseLayout title={argument ? `${argument.title} · Vorgeschlagenes Argument` : "Vorgeschlagenes Argument · Käuferforum"}>
  {access.hasFullAccess && argument ? (
    <>
  <section class="thread-page">
    <a class="back-link" href="/forum/suggest">
      ← Zurück zu vorgeschlagenen Argumenten
    </a>

    <div class="thread-hero upgraded">
      <div>
        <p class="eyebrow">Vorgeschlagenes Argument</p>
        <h1>{argument.title}</h1>
        <p>{argument.description}</p>
      </div>

      <div class="thread-hero-meta">
        <span>{argument.status}</span>
        <span>{argumentProfile?.nickname ?? "Unbekannt"}</span>
        <span>
          {new Date(argument.created_at).toLocaleDateString("de-DE")}
        </span>
      </div>
    </div>

    <section class="threads-section">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">Diskussionen</p>
          <h2>Threads zu diesem Argument</h2>
        </div>
      </div>

      {
        displayThreads.length > 0 ? (
          <div class="thread-list">
            {displayThreads.map((thread) => (
              <ThreadPreview thread={thread} />
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <h3>Noch keine Threads</h3>
            <p>
              Starte die erste Diskussion zu diesem vorgeschlagenen Argument.
            </p>
          </div>
        )
      }

      <div style="margin-top: 2rem;">
        <CreateSuggestedThreadForm
          client:load
          suggestedArgumentId={argument.id}
        />
      </div>
    </section>
  </section>
    </>
  ) : (
    <AccessGate returnTo={`/forum/suggest/${id}`} eyebrow="Käuferforum" />
  )}
</BaseLayout>
