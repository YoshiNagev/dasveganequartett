---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AccessGate from "../../../components/access/AccessGate.astro";
import { getAccessState } from "../../../lib/server/access";
import { createSupabaseServerClient } from "../../../lib/supabaseServer";

export const prerender = false;

const access = await getAccessState(Astro.cookies, Astro.request);
const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
let suggestedArguments: any[] = [];

if (access.hasFullAccess) {
  const { data, error } = await supabase
    .from("suggested_arguments")
    .select(`
      id,
      title,
      description,
      status,
      created_at,
      profiles (nickname),
      threads (id)
    `)
    .eq("is_hidden", false)
    .order("created_at", { ascending: false });

  if (error) console.error(error);
  suggestedArguments = data ?? [];
}
---

<BaseLayout title="Vorgeschlagene Argumente">
  {access.hasFullAccess ? (
    <>
  <section class="page-header">
    <p class="eyebrow">Forum · Community</p>
    <h1>Vorgeschlagene Argumente</h1>
    <p>
      Hier sammeln Nutzerinnen und Nutzer seltene oder neue Argumente, die nicht zu den
      54 offiziellen Quartett-Karten gehören.
    </p>

    <div style="margin-top: 1.5rem;">
      <a class="create-thread-link" href="/forum/suggest/new">
        Neues Argument vorschlagen
      </a>
    </div>
  </section>

  <section class="suggested-argument-grid">
    {
      suggestedArguments.length > 0 ? (
        suggestedArguments.map((argument) => (
          <a
            class="suggested-argument-card"
            href={`/forum/suggest/${argument.id}`}
          >
            <div>
              <span class="suggested-status">{argument.status}</span>
              <h2>{argument.title}</h2>
              <p>{argument.description}</p>
            </div>

            <div class="suggested-meta">
              <span>{argument.profiles?.nickname ?? "Unbekannt"}</span>
              <span>
                {argument.threads?.length === 1
                  ? "1 Thread"
                  : `${argument.threads?.length ?? 0} Threads`}
              </span>
              <span>
                {new Date(argument.created_at).toLocaleDateString("de-DE")}
              </span>
            </div>
          </a>
        ))
      ) : (
        <div class="empty-state">
          <h3>Noch keine Vorschläge</h3>
          <p>
            Bisher wurden keine zusätzlichen Argumente vorgeschlagen.
            Starte den ersten Vorschlag.
          </p>
        </div>
      )
    }
  </section>
    </>
  ) : (
    <AccessGate
      returnTo="/forum/suggest"
      eyebrow="Käuferforum"
      title="Community-Vorschläge sind Teil des vollständigen Forums."
    />
  )}
</BaseLayout>
