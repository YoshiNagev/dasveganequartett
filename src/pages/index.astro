---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialCardFan from "../components/landing/EditorialCardFan.astro";
import { preorderConfig } from "../data/preorderConfig";
const price = new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR", maximumFractionDigits: 0 }).format(preorderConfig.presalePrice);
const modes = [
  { title: "Trumpfen / Quartett", text: "Werte vergleichen, Karten gewinnen. Die sechs Bewertungen bringen bekannte Einwände spielerisch auf den Tisch.", number: "01" },
  { title: "Bootcamp", text: "Argumente prüfen und Antworten üben. Nutzt die Karten, um euer Wissen gemeinsam zu testen und zu erweitern.", number: "02" },
  { title: "Ice Breaker", text: "Eine Karte ziehen und ins Gespräch kommen. Welche Gedanken löst der Einwand aus? Welche Perspektiven fehlen?", number: "03" },
];
---
<BaseLayout title="Das Vegane Quartett" design="editorial"
  description="Diese Diskussion kennst du schon. Entdecke 54 typische Einwände gegen Veganismus als Kartenspiel – mit drei Spielmodi, Quellen und ausführlichen Einordnungen."
  image="/images/preorder/product-01.jpeg">
  <section class="ed-hero" aria-labelledby="hero-title">
    <div class="ed-hero-copy">
      <p class="ed-kicker">Das Kartenspiel von Yoshi</p>
      <h1 id="hero-title">Diese Diskussion<br />kennst du schon.</h1>
      <p class="ed-lead">54 typische Einwände gegen Veganismus.<br class="ed-desktop-break" /> Ein Kartenspiel zum Hinterfragen, Kontern und Diskutieren.</p>
      <div class="ed-actions">
        <a class="ed-button" href={preorderConfig.preorderOpen ? "/preorder" : `mailto:${preorderConfig.contactEmail}`}>
          {preorderConfig.preorderOpen ? "Jetzt vorbestellen" : "Verfügbarkeit anfragen"} <span aria-hidden="true">↗</span>
        </a>
        <a class="ed-text-link" href="#karten-preview" data-draw-card>
         <span class="ed-link-label">Eine Karte ziehen</span>
         <span aria-hidden="true">→</span>
        </a>
      </div>
      {preorderConfig.preorderOpen && <p class="ed-small">{price} im Vorverkauf · zzgl. {preorderConfig.shippingCost} € Versand</p>}
    </div>
    <EditorialCardFan />
  </section>

  <section class="ed-game ed-section" id="das-spiel" aria-labelledby="game-title">
    <div class="ed-game-intro">
      <p class="ed-kicker">Das Spiel</p>
      <h2 id="game-title">Auf den Tisch.<br />Ins Gespräch.</h2>
      <p>Manche Einwände hört man immer wieder. Das Vegane Quartett macht daraus ein Spiel.</p>
      <p>Für gemeinsame Spielabende, zum individuellen Lernen und als einfacher Diskussionsstarter.</p>
      <a class="ed-text-link" href="/rules">So wird gespielt <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="ed-product-photo">
      <img src="/images/preorder/product-01.jpeg" alt="Das echte Kartendeck mit farbiger Titelkarte auf hellem Untergrund" width="1200" height="1600" loading="lazy" />
      <figcaption>54 Argumentkarten + Deckkarte. Im transparenten Etui.</figcaption>
    </figure>
    <div class="ed-modes">
      <h3>Drei Spielmodi.</h3>
      {modes.map(mode => <details name="play-mode" open={mode.number === "01"}>
        <summary><span class="ed-mode-number">{mode.number}</span><span>{mode.title}</span><span class="ed-toggle" aria-hidden="true">+</span></summary>
        <p>{mode.text}</p>
      </details>)}
      <a class="ed-text-link" href="/rules">Zur vollständigen Anleitung <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="ed-knowledge ed-section" aria-labelledby="knowledge-title">
    <div>
      <p class="ed-kicker">Die Karte ist der Anfang</p>
      <h2 id="knowledge-title">Und was antwortest du?</h2>
      <p>Zu jedem Argument gibt es eine eigene Seite mit ausführlicher Einordnung, Quellen und Platz für Diskussionen. Der QR-Code auf der Rückseite führt direkt dorthin.</p>
      <a class="ed-text-link" href="/cards">Sechs Argumente kennenlernen <span aria-hidden="true">↗</span></a>
    </div>
    <div class="ed-quote">
      <span class="ed-quote-number">Karte 01 · Philosophische Argumente</span>
      <blockquote>„Pflanzen haben<br />auch Gefühle.“</blockquote>
      <a class="ed-text-link" href="/cards/1">Die Einordnung lesen <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="ed-buy ed-section" aria-labelledby="buy-title">
    <div><p class="ed-kicker">Dein nächster Spieleabend</p><h2 id="buy-title">Ein Deck.<br />Viele Perspektiven.</h2></div>
    <div class="ed-buy-copy">
      <p>54 Argumentkarten, drei Spielmodi und digitaler Zugang zu allen Argumentseiten. Zum Selberspielen oder Verschenken.</p>
      <p class="ed-small">{preorderConfig.preorderOpen ? `Versand ab ${preorderConfig.estimatedShippingDate}` : "Aktuelle Verfügbarkeit auf Anfrage"} · Lieferung innerhalb Deutschlands</p>
    </div>
    <div class="ed-buy-action">
      {preorderConfig.preorderOpen && <><span class="ed-price">{price}</span><span class="ed-small">pro Deck · später {preorderConfig.regularPrice} €<br />zzgl. {preorderConfig.shippingCost} € Versand pro Bestellung</span></>}
      <a class="ed-button" href={preorderConfig.preorderOpen ? "/preorder" : `mailto:${preorderConfig.contactEmail}`}>{preorderConfig.preorderOpen ? "Zum Vorverkauf" : "Kontakt aufnehmen"} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="ed-extra ed-section" aria-labelledby="extra-title">
    <a class="ed-pdf-cover" href="/54-argumente-fuer-veganismus" tabindex="-1" aria-hidden="true"><img src="/images/54-argumente-fuer-veganismus-cover.png" width="1200" height="1697" loading="lazy" alt="" /></a>
    <div>
      <p class="ed-kicker">Kostenlos weiterlesen</p>
      <h2 id="extra-title">54 Argumente<br /><em>für</em> Veganismus.</h2>
      <p>Das Gegenstück zu den Einwänden im Spiel: 54 Zugänge zu der Frage, warum Tiere nicht für menschliche Zwecke ausgebeutet werden sollten.</p>
      <a class="ed-text-link" href="/54-argumente-fuer-veganismus">Die kostenlose PDF entdecken <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="ed-community"><p class="ed-kicker">Gemeinsam weiterdenken</p><h3>Deine Perspektive fehlt noch.</h3><p>Fragen, Einwände oder eine andere Sicht? Im Forum geht das Gespräch weiter.</p><a class="ed-text-link" href="/forum">Zum Forum <span aria-hidden="true">↗</span></a></aside>
  </section>
</BaseLayout>
