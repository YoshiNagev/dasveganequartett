---
import BaseLayout from "../layouts/BaseLayout.astro";
import PreorderConfigurator from "../components/preorder/preorderConfigurator";
import { product } from "../data/product";
import { preorderConfig } from "../data/preorderConfig";

const productImages = [
  {
    src: "/images/preorder/product-01.jpeg",
    alt: "Das Vegane Quartett als Kartenstapel mit Titelkarte",
  },
  {
    src: "/images/preorder/product-02.jpeg",
    alt: "Aufgefächerte Karten aus den verschiedenen Kategorien des Veganen Quartetts",
  },
  {
    src: "/images/preorder/product-03.jpeg",
    alt: "Das Vegane Quartett im transparenten Etui",
  },
  {
    src: "/images/preorder/product-04.jpeg",
    alt: "Grüne Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-05.jpeg",
    alt: "Blaue Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-06.jpeg",
    alt: "Violette Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-07.jpeg",
    alt: "Rote Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-08.jpeg",
    alt: "Pinke Beispielkarte aus dem Veganen Quartett",
  },
] as const;
---

<BaseLayout
  title="Das Vegane Quartett vorbestellen"
  description="Das Vegane Quartett im Presale für 12 Euro pro Deck vorbestellen. Pauschal 3 Euro Versand. Versandstart ist der 20. November 2026."
>
  <section class="preorder-page">
    <div class="preorder-copy">
      <p class="eyebrow">Vorbestellung</p>
      <h1>{product.name}</h1>

      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery-stage">
          <img
            class="product-gallery-main-image"
            data-gallery-main
            src={productImages[0].src}
            alt={productImages[0].alt}
            width="1200"
            height="1600"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />

          <button
            class="product-gallery-nav product-gallery-nav--previous"
            type="button"
            data-gallery-previous
            aria-label="Vorheriges Produktbild"
          >
            <span aria-hidden="true">‹</span>
          </button>
          <button
            class="product-gallery-nav product-gallery-nav--next"
            type="button"
            data-gallery-next
            aria-label="Nächstes Produktbild"
          >
            <span aria-hidden="true">›</span>
          </button>

          <div class="product-gallery-counter" aria-live="polite">
            <span data-gallery-current>1</span> / {productImages.length}
          </div>
        </div>

        <div class="product-gallery-thumbnails" aria-label="Produktbilder auswählen">
          {productImages.map((image, index) => (
            <button
              class:list={[
                "product-gallery-thumbnail",
                index === 0 && "is-active",
              ]}
              type="button"
              data-gallery-thumbnail
              data-index={index}
              data-src={image.src}
              data-alt={image.alt}
              aria-label={`Produktbild ${index + 1} anzeigen`}
              aria-current={index === 0 ? "true" : undefined}
            >
              <img
                src={image.src}
                alt=""
                width="240"
                height="320"
                loading={index < 4 ? "eager" : "lazy"}
                decoding="async"
              />
            </button>
          ))}
        </div>
      </div>

      <p class="preorder-lead">
        Sichere dir das Quartett während des Presales für
        <strong> {preorderConfig.presalePrice.toFixed(0)} € pro Deck</strong>. Nach Ende des Presales steigt der
        reguläre Preis auf {preorderConfig.regularPrice.toFixed(0)} € pro Deck.
      </p>

      <div class="delivery-highlight">
        <span>Versandstart</span>
        <strong>{preorderConfig.estimatedShippingDate}</strong>
      </div>

      <ul class="preorder-list">
        {product.contents.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <div class="preorder-info">
        <h2>So funktioniert die Vorbestellung</h2>
        <p>
          Du kannst regulär ein bis vier Decks bestellen. Die Versandkosten
          betragen pauschal {preorderConfig.shippingCost.toFixed(0)} € pro Bestellung und erhöhen sich nicht mit der
          gewählten Stückzahl.
        </p>
        <p>
          Der Versand der vorbestellten Decks startet am <strong>{preorderConfig.estimatedShippingDate}</strong>.
          Preis, Versandkosten und Gesamtbetrag werden dir vor Abschluss der
          Bestellung noch einmal vollständig angezeigt.
        </p>
      </div>
    </div>

    <aside class="preorder-checkout-card">
      <PreorderConfigurator client:load />
    </aside>
  </section>
</BaseLayout>

<script>
  const galleries = document.querySelectorAll("[data-product-gallery]");

  galleries.forEach((gallery) => {
    const mainImage = gallery.querySelector("[data-gallery-main]");
    const counter = gallery.querySelector("[data-gallery-current]");
    const thumbnails = Array.from(
      gallery.querySelectorAll("[data-gallery-thumbnail]")
    );
    const previousButton = gallery.querySelector("[data-gallery-previous]");
    const nextButton = gallery.querySelector("[data-gallery-next]");

    if (!(mainImage instanceof HTMLImageElement) || thumbnails.length === 0) {
      return;
    }

    let currentIndex = 0;

    const showImage = (index) => {
      const normalizedIndex =
        (index + thumbnails.length) % thumbnails.length;
      const thumbnail = thumbnails[normalizedIndex];

      if (!(thumbnail instanceof HTMLButtonElement)) return;

      const nextSrc = thumbnail.dataset.src;
      const nextAlt = thumbnail.dataset.alt;
      if (!nextSrc || !nextAlt) return;

      currentIndex = normalizedIndex;
      mainImage.src = nextSrc;
      mainImage.alt = nextAlt;

      if (counter) counter.textContent = String(currentIndex + 1);

      thumbnails.forEach((item, itemIndex) => {
        const isActive = itemIndex === currentIndex;
        item.classList.toggle("is-active", isActive);

        if (isActive) {
          item.setAttribute("aria-current", "true");
        } else {
          item.removeAttribute("aria-current");
        }
      });
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener("click", () => showImage(index));
    });

    previousButton?.addEventListener("click", () => showImage(currentIndex - 1));
    nextButton?.addEventListener("click", () => showImage(currentIndex + 1));
  });
</script>

<style>
  .preorder-page {
    align-items: start;
  }

  .preorder-copy {
    min-width: 0;
  }

  .product-gallery {
    width: min(100%, 680px);
    margin: 2rem 0 2.2rem;
  }

  .product-gallery-stage {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 24px;
    background: var(--surface);
    box-shadow: var(--shadow-strong);
  }

  .product-gallery-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-gallery-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 46px;
    height: 46px;
    padding: 0;
    display: grid;
    place-items: center;
    transform: translateY(-50%);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(7, 9, 10, 0.72);
    color: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease;
  }

  .product-gallery-nav:hover {
    transform: translateY(-50%) scale(1.06);
    border-color: rgba(126, 255, 203, 0.65);
    background: rgba(7, 9, 10, 0.88);
  }

  .product-gallery-nav:focus-visible,
  .product-gallery-thumbnail:focus-visible {
    outline: 3px solid rgba(126, 255, 203, 0.5);
    outline-offset: 3px;
  }

  .product-gallery-nav span {
    display: block;
    margin-top: -0.12em;
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
  }

  .product-gallery-nav--previous {
    left: 1rem;
  }

  .product-gallery-nav--next {
    right: 1rem;
  }

  .product-gallery-counter {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    padding: 0.42rem 0.68rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    background: rgba(7, 9, 10, 0.72);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 850;
    backdrop-filter: blur(12px);
  }

  .product-gallery-thumbnails {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .product-gallery-thumbnail {
    min-width: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 11px;
    background: var(--surface);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
    cursor: pointer;
    opacity: 0.72;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  .product-gallery-thumbnail:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .product-gallery-thumbnail.is-active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(126, 255, 203, 0.12);
    opacity: 1;
  }

  .product-gallery-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preorder-lead strong {
    color: var(--text);
  }

  .delivery-highlight {
    display: inline-grid;
    gap: 0.25rem;
    margin: 1.3rem 0 0.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgba(126, 255, 203, 0.25);
    border-radius: 14px;
    background: rgba(126, 255, 203, 0.07);
  }

  .delivery-highlight span {
    color: var(--muted-text);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .delivery-highlight strong {
    color: var(--accent);
    font-size: 1.15rem;
  }

  .preorder-info {
    margin-top: 2rem;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
  }

  .preorder-info h2 {
    margin: 0 0 0.8rem;
    font-size: 1.4rem;
  }

  .preorder-info p {
    margin: 0.65rem 0 0;
    color: var(--muted-text);
    line-height: 1.65;
  }

  :global(.checkout-account) {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid rgba(126, 255, 203, 0.24);
    border-radius: 14px;
    background: rgba(126, 255, 203, 0.065);
  }

  :global(.checkout-account > span) {
    color: var(--muted-text);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  :global(.checkout-account > div) {
    display: grid;
    gap: 0.3rem;
  }

  :global(.checkout-account small) {
    color: var(--muted-text);
    line-height: 1.5;
  }

  :global(.checkout-account a) {
    width: fit-content;
    margin-top: 0.35rem;
    color: var(--accent);
    font-weight: 850;
  }

  :global(.checkout-account-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  :global(.digital-access-info) {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    border: 1px solid rgba(159, 209, 255, 0.22);
    border-radius: 14px;
    background: rgba(159, 209, 255, 0.06);
  }

  :global(.digital-access-info strong) {
    color: var(--text);
  }

  :global(.digital-access-info p) {
    margin: 0;
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  :global(.digital-access-info a) {
    color: var(--accent);
    font-weight: 850;
  }

  .preorder-checkout-card {
    position: sticky;
    top: 7rem;
  }

  @media (max-width: 900px) {
    .preorder-checkout-card {
      position: static;
    }

    .product-gallery {
      width: min(100%, 620px);
    }
  }

  @media (max-width: 620px) {
    .product-gallery {
      margin-top: 1.5rem;
    }

    .product-gallery-stage {
      border-radius: 18px;
    }

    .product-gallery-nav {
      width: 42px;
      height: 42px;
    }

    .product-gallery-nav--previous {
      left: 0.7rem;
    }

    .product-gallery-nav--next {
      right: 0.7rem;
    }

    .product-gallery-counter {
      right: 0.7rem;
      bottom: 0.7rem;
    }

    .product-gallery-thumbnails {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 72px;
      overflow-x: auto;
      padding: 0.15rem 0.15rem 0.6rem;
      scroll-snap-type: x proximity;
      scrollbar-width: thin;
    }

    .product-gallery-thumbnail {
      scroll-snap-align: start;
    }
  }
</style>

<style is:global>
  .preorder-configurator,
  .preorder-configurator *,
  .preorder-configurator *::before,
  .preorder-configurator *::after {
    box-sizing: border-box;
  }

  .preorder-configurator {
    display: grid;
    gap: 1.2rem;
    min-width: 0;
  }

  .presale-badge {
    width: fit-content;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: #07110d;
    background: var(--accent);
    font-size: 0.76rem;
    font-weight: 950;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .price-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
  }

  .price-label {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--muted-text);
    font-size: 0.88rem;
  }

  .current-price {
    display: block;
    font-size: clamp(2.8rem, 6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .regular-price-box {
    display: grid;
    gap: 0.1rem;
    min-width: 94px;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--background);
    text-align: right;
  }

  .regular-price-box span,
  .regular-price-box small {
    color: var(--muted-text);
    font-size: 0.75rem;
  }

  .order-summary {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--background);
  }

  .order-summary > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .order-summary span {
    color: var(--muted-text);
  }

  .order-total {
    margin-top: 0.1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border);
    font-size: 1.15rem;
  }

  .order-total span,
  .order-total strong {
    color: var(--text);
  }

  .shipping-note,
  .checkout-hint {
    margin: 0;
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .checkout-button {
    width: 100%;
    min-height: 52px;
    border: 0;
    border-radius: 999px;
    color: #07110d;
    background: var(--accent);
    font: inherit;
    font-weight: 950;
    cursor: pointer;
  }

  .checkout-button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .bulk-order-note {
    display: grid;
    gap: 0.55rem;
    padding: 1rem;
    border: 1px solid rgba(159, 209, 255, 0.22);
    border-radius: 14px;
    background: rgba(159, 209, 255, 0.06);
  }

  .bulk-order-note p {
    margin: 0;
    color: var(--muted-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .bulk-order-note a {
    width: fit-content;
    color: var(--accent);
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 420px) {
    .price-row {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .regular-price-box {
      width: 100%;
      text-align: left;
    }

    .preorder-checkout-card {
      padding: 1.25rem;
      border-radius: 1.4rem;
    }
  }



  .quantity-field {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .quantity-field legend {
    margin-bottom: 0.65rem;
    padding: 0;
    color: var(--text);
    font-weight: 900;
  }

  .quantity-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .quantity-option {
    min-width: 0;
    min-height: 104px;
    padding: 0.85rem 0.6rem;

    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.15rem;

    border: 1px solid var(--border);
    border-radius: 14px;

    background: var(--background);
    color: var(--text);

    font: inherit;
    text-align: center;
    cursor: pointer;

    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease,
      box-shadow 0.18s ease;
  }

  .quantity-option:hover {
    transform: translateY(-2px);
    border-color: rgba(126, 255, 203, 0.42);
    background: rgba(126, 255, 203, 0.055);
  }

  .quantity-option:focus-visible {
    outline: 3px solid rgba(126, 255, 203, 0.3);
    outline-offset: 3px;
  }

  .quantity-option.is-selected {
    border-color: var(--accent);
    background:
      radial-gradient(
        circle at top,
        rgba(126, 255, 203, 0.2),
        transparent 75%
      ),
      rgba(126, 255, 203, 0.09);
    box-shadow:
      inset 0 0 0 1px rgba(126, 255, 203, 0.16),
      0 10px 28px rgba(0, 0, 0, 0.16);
  }

  .quantity-option-number {
    color: var(--accent);
    font-size: 1.45rem;
    font-weight: 950;
    line-height: 1;
  }

  .quantity-option-label {
    font-size: 0.88rem;
    font-weight: 900;
  }

  .quantity-option small {
    margin-top: 0.2rem;
    color: var(--muted-text);
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .quantity-option.is-selected small {
    color: var(--text);
  }

  @media (max-width: 520px) {
    .quantity-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .quantity-option {
      min-height: 92px;
    }
  }



</style>
