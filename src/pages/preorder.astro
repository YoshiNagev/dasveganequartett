---
import BaseLayout from "../layouts/BaseLayout.astro";
import PreorderConfigurator from "../components/preorder/preorderConfigurator";
import "../styles/preorder-editorial.css";
import { preorderConfig } from "../data/preorderConfig";

const productImages = [
  {
    src: "/images/preorder/product-01.jpeg",
    alt: "Das Vegane Quartett als Kartenstapel mit Titelkarte",
  },
  {
    src: "/images/preorder/product-03.jpeg",
    alt: "Aufgefächerte Karten aus den verschiedenen Kategorien des Veganen Quartetts",
  },
  {
    src: "/images/preorder/product-02.jpeg",
    alt: "Das Vegane Quartett im transparenten Etui",
  },
  {
    src: "/images/preorder/product-04.jpeg",
    alt: "Grüne Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-05.jpeg",
    alt: "Blaue Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-06.jpeg",
    alt: "Violette Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-07.jpeg",
    alt: "Rote Beispielkarte aus dem Veganen Quartett",
  },
  {
    src: "/images/preorder/product-08.jpeg",
    alt: "Pinke Beispielkarte aus dem Veganen Quartett",
  },
] as const;
---
<BaseLayout design="editorial" title="Das Vegane Quartett vorbestellen"
  description={`Das Vegane Quartett: ${preorderConfig.presalePrice} € pro Deck im Vorverkauf, ${preorderConfig.shippingCost} € Versand innerhalb Deutschlands. Versand ab ${preorderConfig.estimatedShippingDate}.`}>
  <div class="ep-shop">
    <header class="ep-heading"><p class="ed-kicker">Das Kartenspiel von Yoshi · Vorverkauf</p><h1>Ein Deck.<br />Viel Gesprächsstoff.</h1><p>54 bekannte Einwände gegen Veganismus. Zum Hinterfragen, Kontern und gemeinsamen Spielen.</p></header>
    <div class="ep-columns">
      <div class="ep-product">
        <section class="ep-gallery" data-product-gallery aria-label="Produktfotos">
          <div class="ep-stage"><img data-gallery-main src={productImages[0].src} alt={productImages[0].alt} width="1200" height="1600" fetchpriority="high" />
          </div>
          <div class="ep-gallery-controls"><button type="button" data-gallery-previous aria-label="Vorheriges Produktbild">←</button><p aria-live="polite">Bild <span data-gallery-current>1</span> / {productImages.length}</p><button type="button" data-gallery-next aria-label="Nächstes Produktbild">→</button></div>
          <div class="ep-thumbs" aria-label="Produktbild auswählen">{productImages.map((image,index) => <button type="button" data-gallery-thumbnail data-src={image.src} data-alt={image.alt} class:list={[index === 0 && "is-active"]} aria-current={index === 0 ? "true" : undefined} aria-label={`Produktbild ${index+1} anzeigen`}><img src={image.src} alt="" width="120" height="160" loading="lazy" /></button>)}</div>
        </section>
        <section class="ep-included"><p class="ed-kicker">Das steckt drin</p><dl><div><dt>54 Argumentkarten + Deckkarte</dt><dd>Sechs Kategorien, sechs Bewertungen und reichlich Anlass zum Diskutieren.</dd></div><div><dt>Transparentes Etui</dt><dd>Das komplette Deck zusammen verstaut.</dd></div><div><dt>Digitaler Begleitbereich</dt><dd>Ein Zugang pro Deck: alle Argumentseiten mit Einordnungen und Diskussionen.</dd></div></dl><a href="/rules">Die drei Spielmodi kennenlernen →</a></section>
      </div>
      <aside class="ep-order" aria-label="Vorbestellung zusammenstellen"><PreorderConfigurator client:load /><noscript><p>Bitte aktiviere JavaScript, um den Preis zu berechnen und die Bestellung zu starten.</p></noscript></aside>
    </div>
    <section class="ep-notes"><div><p class="ed-kicker">Lieferung</p><p>Versand ab <strong>{preorderConfig.estimatedShippingDate}</strong>. Aktuell liefern wir innerhalb Deutschlands. Der Versand kostet pauschal {preorderConfig.shippingCost} € pro Bestellung.</p></div><div><p class="ed-kicker">Noch eine Frage?</p><details><summary>Kann ich ein Deck verschenken?</summary><p>Ja. Nach der Zahlung findest du die digitalen Zugänge in deinem Profil. Dort kannst du einen Zugang per Geschenklink weitergeben. Die Details zum eigenen und zusätzlichen Zugang stehen oben bei deiner Bestellung.</p></details><details><summary>Wo finde ich die Spielanleitung?</summary><p>Die Anleitung für Trumpfen / Quartett, Bootcamp und Ice Breaker findest du <a href="/rules">hier auf der Website</a>.</p></details><details><summary>Ich brauche mehr als vier Decks.</summary><p>Schreib mir an <a href={`mailto:${preorderConfig.contactEmail}`}>{preorderConfig.contactEmail}</a>, zum Beispiel für eine Schule, einen Verein oder eine Veranstaltung.</p></details></div></section>
  </div>
</BaseLayout>
<script>
  const galleries = document.querySelectorAll("[data-product-gallery]");

  galleries.forEach((gallery) => {
    const mainImage = gallery.querySelector("[data-gallery-main]");
    const counter = gallery.querySelector("[data-gallery-current]");
    const thumbnails = Array.from(
      gallery.querySelectorAll("[data-gallery-thumbnail]")
    );
    const previousButton = gallery.querySelector("[data-gallery-previous]");
    const nextButton = gallery.querySelector("[data-gallery-next]");

    if (!(mainImage instanceof HTMLImageElement) || thumbnails.length === 0) {
      return;
    }

    let currentIndex = 0;
    gallery.addEventListener("keydown", event => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
        event.preventDefault();
        showImage(currentIndex + (event.key === "ArrowRight" ? 1 : -1));
      }
    });

    const showImage = (index: number) => {
      const normalizedIndex =
        (index + thumbnails.length) % thumbnails.length;
      const thumbnail = thumbnails[normalizedIndex];

      if (!(thumbnail instanceof HTMLButtonElement)) return;

      const nextSrc = thumbnail.dataset.src;
      const nextAlt = thumbnail.dataset.alt;
      if (!nextSrc || !nextAlt) return;

      currentIndex = normalizedIndex;
      mainImage.src = nextSrc;
      mainImage.alt = nextAlt;

      if (counter) counter.textContent = String(currentIndex + 1);

      thumbnails.forEach((item, itemIndex) => {
        const isActive = itemIndex === currentIndex;
        item.classList.toggle("is-active", isActive);

        if (isActive) {
          item.setAttribute("aria-current", "true");
        } else {
          item.removeAttribute("aria-current");
        }
      });
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener("click", () => showImage(index));
    });

    previousButton?.addEventListener("click", () => showImage(currentIndex - 1));
    nextButton?.addEventListener("click", () => showImage(currentIndex + 1));
  });
</script>