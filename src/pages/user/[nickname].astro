---
import "../../styles/public-profile-editorial.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThreadPreview from "../../components/forum/ThreadPreview.astro";
import MarkdownText from "../../components/forum/MarkdownText";
import { cards } from "../../data/cards";
import { isPublicCardId } from "../../lib/access";
import { getAccessState } from "../../lib/server/access";
import { createSupabaseServerClient } from "../../lib/supabaseServer";

export const prerender = false;

const supabase = createSupabaseServerClient(Astro.cookies, Astro.request);
const access = await getAccessState(Astro.cookies, Astro.request);

const nickname = Astro.params.nickname;

const { data: profile, error: profileError } = await supabase
  .from("profiles")
  .select("id, nickname, bio, avatar_url, role, created_at")
  .eq("nickname", nickname)
  .maybeSingle();

if (profileError || !profile) {
  return Astro.redirect("/forum");
}

const { data: threads, error: threadsError } = await supabase
  .from("threads")
  .select(`
    id,
    card_id,
    suggested_argument_id,
    title,
    body,
    slug,
    created_at,
    comments (
      id
    ),
    suggested_arguments (
      title
    )
  `)
  .eq("user_id", profile.id)
  .eq("is_hidden", false)
  .order("created_at", { ascending: false });

const { data: comments, error: commentsError } = await supabase
  .from("comments")
  .select(`
    id,
    thread_id,
    body,
    created_at,
    threads!inner (
      slug,
      title,
      is_hidden,
      card_id,
      suggested_argument_id
    )
  `)
  .eq("user_id", profile.id)
  .eq("is_hidden", false)
  .eq("threads.is_hidden", false)
  .order("created_at", { ascending: false })
  .limit(10);

const accessibleThreads = access.hasFullAccess
  ? threads
  : threads?.filter(
      (thread) => Boolean(thread.card_id) && isPublicCardId(thread.card_id)
    );

const displayThreads =
  accessibleThreads?.map((thread) => {
    const card = thread.card_id
      ? cards.find((item) => item.id === thread.card_id)
      : null;

    const suggestedArgument = Array.isArray(thread.suggested_arguments)
      ? thread.suggested_arguments[0]
      : thread.suggested_arguments;

    const contextLabel = card
      ? `Karte #${String(card.id).padStart(2, "0")} · ${card.title}`
      : thread.suggested_argument_id
        ? `Vorgeschlagenes Argument · ${
            suggestedArgument?.title ?? "Unbekanntes Argument"
          }`
        : "Allgemeine Diskussion";

    return {
      id: thread.slug,
      cardId: thread.card_id,
      title: thread.title,
      excerpt: thread.body,
      author: profile.nickname,
      replies: thread.comments?.length ?? 0,
      createdAt: new Date(thread.created_at).toLocaleDateString("de-DE"),
      contextLabel,
    };
  }) ?? [];

const displayComments = (comments ?? []).flatMap((comment) => {
  const thread = Array.isArray(comment.threads)
    ? comment.threads[0]
    : comment.threads;
  if (!thread) return [];
  if (!access.hasFullAccess && !isPublicCardId(thread.card_id)) return [];
  return [{ ...comment, thread }];
});
---

<BaseLayout title={`${profile.nickname} · Profil`} noindex={true} design="editorial">
  <div class="ep-profile">
    <a class="ep-back" href="/forum">← Zum Forum</a>
    <header class="ep-hero">
      <div class="ep-avatar">
        {profile.avatar_url ? (
          <img src={profile.avatar_url} alt={`Avatar von ${profile.nickname}`} width="144" height="144" />
        ) : <span aria-hidden="true">{profile.nickname.slice(0, 2).toUpperCase()}</span>}
      </div>
      <div class="ep-intro">
        <p class="ep-kicker">Aus der Community</p>
        <h1>{profile.nickname}</h1>
        <p class="ep-bio">{profile.bio || "Diese Person hat noch keine Profilbeschreibung ergänzt."}</p>
        <div class="ep-details">
          <span class="ep-role">{profile.role === "admin" ? "Administration" : profile.role === "moderator" ? "Moderation" : "Mitglied"}</span>
          <span>Dabei seit <time datetime={profile.created_at}>{new Date(profile.created_at).toLocaleDateString("de-DE")}</time></span>
        </div>
      </div>
    </header>

    <nav class="ep-jump" aria-label="Profilbereiche">
      <a href="#diskussionen">Diskussionen {!threadsError && <span>{displayThreads.length}</span>}</a>
      <a href="#antworten">Neueste Antworten</a>
    </nav>
    {!access.hasFullAccess && <p class="ep-access-note">Hier siehst du Beiträge zu den sechs frei zugänglichen Karten. Mit einem vollständigen Zugang werden auch Beiträge zu den weiteren Karten und Community-Vorschlägen angezeigt.</p>}

    <div class="ep-activity">
      <section id="diskussionen" aria-labelledby="ep-threads-title">
        <p class="ep-kicker">Gespräche eröffnen</p>
        <h2 id="ep-threads-title">Gestartete Diskussionen</h2>
        {threadsError ? (
          <p class="ep-error" role="alert">Die Diskussionen konnten gerade nicht geladen werden. Bitte lade die Seite erneut.</p>
        ) : displayThreads.length > 0 ? (
          <div class="ep-thread-list">{displayThreads.map((thread) => <ThreadPreview thread={thread} />)}</div>
        ) : (
          <div class="ep-empty"><h3>Noch keine sichtbaren Diskussionen</h3><p>Für deinen aktuellen Zugang sind hier noch keine gestarteten Diskussionen sichtbar.</p><a href="/forum">Kartenforen entdecken →</a></div>
        )}
      </section>
      <aside id="antworten" aria-labelledby="ep-comments-title">
        <p class="ep-kicker">Im Austausch</p>
        <h2 id="ep-comments-title">Neueste Antworten</h2>
        <p class="ep-comments-note">Sichtbare Beiträge aus den letzten zehn Kommentaren.</p>
        {commentsError ? (
          <p class="ep-error" role="alert">Die Antworten konnten gerade nicht geladen werden. Bitte lade die Seite erneut.</p>
        ) : displayComments.length > 0 ? (
          <div class="ep-comment-list">{displayComments.map((comment) => (
            <article class="ep-comment">
              <time datetime={comment.created_at}>{new Date(comment.created_at).toLocaleDateString("de-DE")}</time>
              <h3><a href={`/forum/thread/${comment.thread.slug}`}>{comment.thread.title}</a></h3>
              <div class="ep-comment-body"><MarkdownText content={comment.body.length > 180 ? `${comment.body.slice(0, 180)}…` : comment.body} /></div>
              <a class="ep-discussion-link" href={`/forum/thread/${comment.thread.slug}`}>Zur Diskussion →</a>
            </article>
          ))}</div>
        ) : <div class="ep-empty"><p>Unter den letzten zehn Kommentaren sind für deinen aktuellen Zugang keine Antworten sichtbar.</p></div>}
      </aside>
    </div>
  </div>
</BaseLayout>
