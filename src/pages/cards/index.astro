---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardBrowser from "../../components/cards/CardBrowser";
import { cards } from "../../data/cards";
import AccessGate from "../../components/access/AccessGate.astro";
import { PUBLIC_CARD_IDS } from "../../lib/access";
import { getAccessState } from "../../lib/server/access";

export const prerender = false;

const access = await getAccessState(Astro.cookies, Astro.request);
const visibleCards = access.hasFullAccess
  ? cards
  : cards.filter((card) => PUBLIC_CARD_IDS.includes(card.id as (typeof PUBLIC_CARD_IDS)[number]));
const categories = Array.from(
  new Set(visibleCards.map((card) => card.categoryLabel).filter(Boolean))
).sort();
---

<BaseLayout title="Argumentkarten | Das Vegane Quartett">
  <section class="page-header">
    <p class="eyebrow">{access.hasFullAccess ? "Alle Karten" : "6 von 54 Karten"}</p>
    <h1>{access.hasFullAccess ? "Finde jedes Argument schnell wieder." : "Sechs Argumente zum Kennenlernen."}</h1>
    <p>
      {access.hasFullAccess
        ? "Suche nach Argumenten oder Kategorien. Die QR-Codes auf den physischen Karten führen direkt zu den passenden Detailseiten."
        : "Diese sechs Beispielkarten zeigen die Bandbreite des Spiels. Die übrigen 48 Argumente gehören zum vollständigen Deck."}
    </p>
  </section>

  <CardBrowser
    client:load
    cards={visibleCards}
    categories={categories}
  />

  {!access.hasFullAccess && (
    <AccessGate
      returnTo="/cards"
      eyebrow="48 weitere Argumente"
      title="Die vollständige Sammlung steckt im Deck."
      message="Mit einem gekauften Deck erhältst du Zugriff auf alle 54 Argumente, die ausführlichen Einordnungen und den vollständigen Diskussionsbereich."
    />
  )}
</BaseLayout>
