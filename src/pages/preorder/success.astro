---
import "../../styles/checkout-result-editorial.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { stripe } from "../../lib/server/stripe";

export const prerender = false;

const sessionId = Astro.url.searchParams.get("session_id");
let session = null;
let errorMessage = "";

if (!sessionId || !sessionId.startsWith("cs_")) {
  errorMessage = "Die Checkout-Sitzung fehlt oder ist ungültig.";
} else {
  try {
    session = await stripe.checkout.sessions.retrieve(sessionId);
  } catch (error) {
    console.error("Stripe success page error:", error);
    errorMessage = "Die Checkout-Sitzung konnte nicht geladen werden.";
  }
}

const paid = session?.payment_status === "paid";
const amountTotal =
  typeof session?.amount_total === "number"
    ? new Intl.NumberFormat("de-DE", {
        style: "currency",
        currency: "EUR",
      }).format(session.amount_total / 100)
    : null;
---

<BaseLayout design="editorial" title={errorMessage ? "Zahlungsstatus nicht verfügbar" : paid ? "Vielen Dank für deine Bestellung" : "Zahlung wird geprüft"} noindex={true}>
  <section class="ec-result">
    <header>
      <p class="ec-eyebrow">{errorMessage ? "Deine Bestellung" : paid ? "Zahlung erfolgreich" : "Einen Moment noch"}</p>
      <h1>{errorMessage ? "Status gerade nicht verfügbar." : paid ? "Vielen Dank für deine Bestellung!" : "Deine Zahlung wird noch geprüft."}</h1>
      <p class="ec-lead">{errorMessage
        ? "Wir konnten den Zahlungsstatus gerade nicht abrufen. Das bedeutet nicht automatisch, dass deine Zahlung fehlgeschlagen ist."
        : paid ? "Deine Zahlung wurde bestätigt. Schön, dass Das Vegane Quartett bald bei dir mit am Tisch sitzt."
        : "Für diesen Bezahlvorgang liegt noch keine Zahlungsbestätigung vor. Bitte warte einen Moment und prüfe den Status erneut."}</p>
    </header>
    {errorMessage ? (
      <div class="ec-note"><h2>Was du jetzt tun kannst</h2><p>Prüfe dein E-Mail-Postfach auf eine Bestellbestätigung. Starte bitte keine weitere Zahlung, solange unklar ist, ob die erste erfolgreich war.</p><p>Bei Fragen schreib an <a href="mailto:kontakt@dasveganequartett.de">kontakt@dasveganequartett.de</a>.</p></div>
    ) : (
      <dl class="ec-details">
        <div><dt>Status</dt><dd>{paid ? "Bezahlt" : "Bestätigung ausstehend"}</dd></div>
        {amountTotal && <div><dt>Gesamtbetrag</dt><dd>{amountTotal}</dd></div>}
        {session?.customer_details?.email && <div><dt>E-Mail</dt><dd>{session.customer_details.email}</dd></div>}
      </dl>
    )}
    {paid && <div class="ec-note"><h2>Dein Spiel beginnt schon online.</h2><p>Dein erster digitaler Zugang wird für das beim Kauf verwendete Profil freigeschaltet. Weitere Deck-Zugänge kannst du dort als Geschenk weitergeben.</p><p>Die Verarbeitung und die Bestätigungsmail können einen Moment dauern. Falls du die E-Mail nicht findest, schau auch im Spamordner nach.</p></div>}
    <div class="ec-actions">
      {paid ? <a class="ec-primary" href="/account/access">Digitale Zugänge öffnen <span aria-hidden="true">→</span></a> : !errorMessage && <a class="ec-primary" href={Astro.url.pathname + Astro.url.search}>Status erneut prüfen</a>}
      <a href="/">Zur Startseite</a>
    </div>
    {paid && <p class="ec-footnote">Du möchtest direkt loslegen? <a href="/rules">Hier findest du die Spielregeln.</a></p>}
    {!paid && !errorMessage && <p class="ec-footnote">Bitte starte während der Prüfung keine zweite Zahlung. Bei Fragen: <a href="mailto:kontakt@dasveganequartett.de">kontakt@dasveganequartett.de</a>.</p>}
  </section>
</BaseLayout>
